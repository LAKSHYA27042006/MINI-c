// ============================================================
// MiniC Error Handling Demonstration
// ============================================================
// To test individual errors, uncomment one case at a time.
// ============================================================

// Case 1: Lexical Error (Invalid character '@')
// int x = 10 @ 20;

// Case 2: Syntax Error (Missing semicolon)
// int y = 20

// Case 3: Syntax Error (Unclosed parenthesis)
// int z = (10 + 5;

// Case 4: Semantic Error (Undeclared variable)
// undeclared_var = 50;

// Case 5: Semantic Error (Duplicate declaration in same scope)
// int duplicate = 1;
// int duplicate = 2;

// Case 6: Semantic Error (Modulo on float)
// float f = 10.5;
// int rem = f % 2;

// Active demonstration error for command-line test:
int val = 10;
undeclared_target = val + 5;
