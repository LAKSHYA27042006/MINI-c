// ============================================================
// MiniC Primary Academic Demonstration
// ============================================================
// Demonstrates:
// 1. Variable declaration with constant expression
// 2. Variable declaration with algebraic simplification
// 3. While loop with condition and body update
// ============================================================

int x = 3 + 4;
int y = x + 0;

while (y < 20) {
    y = y + 1;
}
